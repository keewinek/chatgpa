# API server port (only used by standalone `deno task dev:api`)
PORT=8000

# PostgreSQL (Neon / Supabase / local). Required for sync + persistent storage.
# Run migrations: deno task -f @chatgpa/api db:migrate
DATABASE_URL=postgresql://user:password@localhost:5432/chatgpa

# Anthropic (Claude) — model czatu ChatGPA: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Token chroniący /api/* przed wywołaniami spoza Ciebie (scheduled task, appka).
# Dowolny losowy string, np. `openssl rand -hex 24`.
CHAT_GPA_TOKEN=

# Brave Search (opcjonalnie — pełne wyniki web.search; bez klucza działa Wikipedia)
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Web Push (powiadomienia PWA na telefonie). Wygeneruj raz:
#   deno run -A npm:web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
