# API server port (only used by standalone `deno task dev:api`)
PORT=8000

# PostgreSQL (Neon / Supabase / local). Required for sync + persistent storage.
# Run migrations: deno task -f @chatgpa/api db:migrate
DATABASE_URL=postgresql://user:password@localhost:5432/chatgpa

# --- Darmowe klucze AI (wystarczy JEDEN; im więcej, tym lepszy fallback) ---
# Gemini (Google AI Studio, bez karty): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (Llama, bez karty): https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (modele :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Z.AI (GLM Flash — darmowe): https://z.ai/model-api
ZAI_API_KEY=

# Mistral La Plateforme (Experiment tier): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Brave Search (opcjonalnie — pełne wyniki web.search; bez klucza działa Wikipedia)
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
