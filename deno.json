{
  "workspace": ["./packages/core", "./packages/api", "./packages/web"],
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "deno task -f @chatgpa/web dev",
    "dev:api": "deno task -f @chatgpa/api dev",
    "build": "deno task -f @chatgpa/web build",
    "start": "deno task -f @chatgpa/web start",
    "test": "deno test -A --unstable-kv packages/api scripts",
    "epic:status": "deno run -A scripts/epic.ts status",
    "epic:done": "deno run -A scripts/epic.ts done",
    "epic:regen": "deno run -A scripts/epic.ts regen",
    "epic:set": "deno run -A scripts/epic.ts set",
    "fmt": "deno fmt",
    "lint": "deno lint packages/core packages/api && deno task -f @chatgpa/web lint",
    "check": "deno check packages/core/**/*.ts packages/api/**/*.ts && deno task -f @chatgpa/web check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  }
}
